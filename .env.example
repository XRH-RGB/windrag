# Copy to .env to connect an OpenAI-compatible HTTP provider.
# BASE_URL should include the API prefix (usually /v1), without /chat/completions.
# Keys stay on the server. Configuring a remote provider sends authorized excerpts to it.
WINDRAG_LLM_BASE_URL=
WINDRAG_LLM_MODEL=
WINDRAG_LLM_API_KEY=
# Optional semantic retrieval. No embedding service: BM25 remains available.
WINDRAG_EMBED_BASE_URL=
WINDRAG_EMBED_MODEL=
WINDRAG_EMBED_API_KEY=
WINDRAG_EMBED_MIN_SCORE=0.35
# Optional fine-tuned BERT service, for example http://127.0.0.1:8766/classify
WINDRAG_BERT_URL=
